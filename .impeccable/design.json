    {
      "name": "Coral primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main creation, upload and save action; main-app sizing.",
      "html": "<button type=\"button\" class=\"ds-primary\">Simpan foto <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5\"></path></svg></button>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:1rem;min-height:52px;padding:.85rem 1.5rem;border-radius:999px;border:1px solid transparent;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-weight:650;font-size:.875rem;line-height:1.6;text-align:center;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;background:var(--accent);color:var(--ink);}.ds-primary:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow:0 4px 12px #24242318;}.ds-primary:disabled{cursor:not-allowed;opacity:.48;}.ds-primary:focus-visible{outline:3px solid var(--ink);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "Outlined secondary action",
      "kind": "button",
