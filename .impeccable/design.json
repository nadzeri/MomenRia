      "html": "<button type=\"button\" class=\"ds-secondary\">Ganti template</button>",
      "css": ".ds-secondary{display:inline-flex;justify-content:center;align-items:center;gap:1rem;min-height:52px;padding:.85rem 1.5rem;border-radius:999px;border:1px solid transparent;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-weight:650;font-size:.875rem;line-height:1.6;text-align:center;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;background:transparent;color:var(--ink);border-color:#b3b2a8;}.ds-secondary:hover{background:var(--soft);}.ds-secondary:disabled{cursor:not-allowed;opacity:.48;}.ds-secondary:focus-visible{outline:3px solid var(--ink);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;}}"
    },
    {
