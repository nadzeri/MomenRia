{$APP_SITE_ADDRESS:http://localhost} {
	encode zstd gzip
	@blockedReady {
		path /health/ready
		not remote_ip private_ranges
	}
	respond @blockedReady 404

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	reverse_proxy web:8000 {
		header_up X-Momenria-Client-IP {remote_host}
	}
}
